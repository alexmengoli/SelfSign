# Copy to .env next to docker-compose.yml and adjust. Never commit .env.
# Restart/recreate the service after changes: docker compose up -d

# Shared access password. Empty disables authentication.
# Changing it revokes every unlocked browser.
APP_PASSWORD=

# Reverse proxies whose X-Forwarded-* headers are trusted: comma-separated IPs/CIDRs
# or true (trust every hop). Empty trusts none (direct access).
TRUST_PROXY=
